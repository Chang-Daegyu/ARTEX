# [한국어 해설] Docker 환경변수 예제
# 실제 사용은 .env로 복사한 뒤 DB 암호를 설정합니다. 원본 기본 이미지 태그와 LLM 공급자 선택값을 지정합니다.
# API 키는 비워 두고 UI에서 설정할 수 있습니다. 실제 .env는 .gitignore로 제외되며 예제에 개인 자격 증명을 넣지 않습니다.
# Docker 部署配置（复制为 .env）
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
